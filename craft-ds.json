  "sources": [
    "web/index.html",
    "web/src/**/*.tsx",
    "web/src/**/*.ts"
  ],
  "styles": [
    "web/src/**/*.css"
  ],
  "exclude": [
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/node_modules/**",
    "**/dist/**"
  ],
  "allow_raw": [],
  "enforce": [
    "colour",
    "radius",
    "font"
  ],
  "themes": [
    "proMedium",
    "pro",
    "proLight",
    "studio",
    "studioLight",
    "classic"
  ],
  "font_sizes": [
    "small",
    "large"
  ],
  "screenshots": {
    "widths": [
      1440,
      820
    ],
    "out": ".ui-check/craft-shots",
    "command": "uv run python scripts/craft_shoot.py --url {url} --out {out} --width {width} --height {height} --theme {theme}"
  },
  "docs": {
    "design": "docs/DESIGN.md",
    "decisions": "docs/DECISIONS.md",
    "lessons": "docs/LESSONS.md",
    "deviations_heading": "Deliberate deviations",
    "scan": [
      "AGENTS.md",
      "CLAUDE.md",
      "GEMINI.md",
      "CONVENTIONS.md",
      "README.md",
      "GUIDE.md",
      "docs/**/*.md",
      ".claude/**/*.md",
      ".agents/**/*.md"
    ]
  },
  "harness": {
    "claude": true,
    "gemini": true,
    "gemini_rule_trigger": "model_decision",
    "hooks": true
  },
  "probes": {
    "disable": []
  }
