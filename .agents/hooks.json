{
  "craft-ds-guard": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|replace_file_content|multi_replace_file_content|notebook_edit|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/craft-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
