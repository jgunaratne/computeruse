# Copy to `.env` and edit. Every key is optional; defaults are shown.
# All settings are also readable as COMPUTERUSE_* environment variables.

# --- model access ------------------------------------------------------------
# Configure at least one provider; leave all unset to use scripted/replay models only.
# `computeruse doctor` shows what is detected.
#
# Claude on Vertex AI (no Anthropic key needed): `gcloud auth application-default login`
# plus a GCP project that has Claude publisher access.
# Access is per project and per model, so several projects may be listed (comma-separated);
# the first is the default, and `computeruse models` shows which project serves which model.
#GOOGLE_CLOUD_PROJECT=my-project,other-project
#GOOGLE_CLOUD_LOCATION=global            # default: global, then us-east5, us-central1, ...
# Claude via the public Anthropic API.
#ANTHROPIC_API_KEY=sk-ant-...
# Gemini via the Developer API (otherwise gemini-* ids go through Vertex with ADC).
#GEMINI_API_KEY=AIza...
# All credentials also accept the COMPUTERUSE_ prefix (COMPUTERUSE_GCP_PROJECT, ...).
#COMPUTERUSE_MODEL_PROVIDER=auto         # auto | anthropic | vertex | gemini | antigravity | none
# Antigravity: models offered by a running Antigravity installation, through its local Language Server.
# Unset → ANTIGRAVITY_LS_ADDRESS / ANTIGRAVITY_CSRF_TOKEN from the environment, else localhost:5387 with the
# token read from the server's index page. The token is a secret: never logged or returned by the API.
#COMPUTERUSE_ANTIGRAVITY_ADDRESS=localhost:5387
#COMPUTERUSE_ANTIGRAVITY_CSRF_TOKEN=
#COMPUTERUSE_ANTIGRAVITY_ARCHIVE=true          # archive each session's conversation when the session ends
#COMPUTERUSE_MODEL=claude-sonnet-4-5     # e.g. claude-opus-5-5, claude-sonnet-5, gemini-3.8-flash, antigravity:<model-id>
# Model discovery: what the picker offers. probe = list the provider catalogues AND verify each model with a
# 1-token request per project (default); list = trust the catalogues; off = suggested ids only, no network.
#COMPUTERUSE_MODEL_DISCOVERY=probe       # probe | list | off
#COMPUTERUSE_MODEL_DISCOVERY_MAX_AGE_S=3600
#COMPUTERUSE_VERTEX_TOOL_MODE=auto       # builtin | toolset | custom (auto: by model family, adapts on 400)
#COMPUTERUSE_THINKING_EFFORT=            # low | medium | high (dropped if the model rejects it)
#COMPUTERUSE_PRICING_OVERRIDES={"claude-opus-5-5": [5, 25]}   # USD per 1M input/output tokens
#COMPUTERUSE_TOOL_VERSION=computer_20250124
#COMPUTERUSE_BETA_FLAG=computer-use-2025-01-24
#COMPUTERUSE_MAX_TOKENS=4096
#COMPUTERUSE_MODEL_MAX_RETRIES=4

# --- server ----------------------------------------------------------------
# Bind to loopback by default. If you expose it, put it behind auth: the API
# can drive a real computer.
#COMPUTERUSE_HOST=127.0.0.1
#COMPUTERUSE_PORT=8787
#COMPUTERUSE_DATA_DIR=data
#COMPUTERUSE_WEB_DIST=web/dist
#COMPUTERUSE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- agent defaults (per-session overrides may only tighten these) ----------
#COMPUTERUSE_DEFAULT_MAX_STEPS=40        # per session up to 5000; can be raised while a session runs
#COMPUTERUSE_DEFAULT_MAX_DURATION_S=900
#COMPUTERUSE_DEFAULT_MAX_COST_USD=3.0
#COMPUTERUSE_SCREENSHOT_HISTORY=3
#COMPUTERUSE_SETTLE_MS=350
#COMPUTERUSE_STUCK_THRESHOLD=3
#COMPUTERUSE_APPROVAL_TIMEOUT_S=600

# --- computers -------------------------------------------------------------
#COMPUTERUSE_BROWSER_SIZE=1280x800
#COMPUTERUSE_CHROME_BINARY=/usr/bin/google-chrome
#COMPUTERUSE_CHROME_START_URL=about:blank
#COMPUTERUSE_DESKTOP_CONNECTOR=          # GNOME monitor connector, e.g. Meta-0 (default: primary)
#COMPUTERUSE_REMOTE_DAEMON_URL=http://sandbox-host:8800
#COMPUTERUSE_REMOTE_DAEMON_TOKEN=change-me
#COMPUTERUSE_REMOTE_LIVE_VIEW_URL=http://sandbox-host:6080/vnc.html
#COMPUTERUSE_DOCKER_IMAGE=computeruse-sandbox:latest
#COMPUTERUSE_PREVIEW_FPS=4
#COMPUTERUSE_CONTROL_PREVIEW_FPS=12       # live preview rate while an operator has taken control
# Chrome profile for the browser computer. persistent (default) keeps cookies, logins and SSO between
# sessions in <data-dir>/chrome-profile (mode 0700; treat it like a password file). One session at a
# time writes to it; concurrent browser sessions get a throwaway copy. ephemeral = fresh profile per session.
#COMPUTERUSE_CHROME_PROFILE_MODE=persistent   # persistent | ephemeral (per-session override: backend_options.profile)
#COMPUTERUSE_CHROME_PROFILE_DIR=          # default: <data-dir>/chrome-profile

# --- guardrails ------------------------------------------------------------
# JSON lists. Empty allowlist = any domain.
#COMPUTERUSE_ALLOWED_DOMAINS=["example.com","wikipedia.org"]
#COMPUTERUSE_BLOCKED_DOMAINS=["evil.test"]
#COMPUTERUSE_BLOCKED_KEYS=["ctrl+alt+Delete","ctrl+alt+BackSpace","ctrl+alt+F1","ctrl+alt+F2"]
#COMPUTERUSE_DESKTOP_BLOCKED_KEYS=["super+l","ctrl+alt+l","alt+F4","super+q","ctrl+q","alt+F2"]
#COMPUTERUSE_MAX_TYPE_LENGTH=4000
