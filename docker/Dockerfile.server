# Control-plane image: API server + built web UI. Pair it with the sandbox
# image via docker-compose.yml (`--profile full`). The server itself never
# needs a display; it talks to sandboxes over the daemon HTTP protocol.
#
# NOTE: not yet built on the development machine (no Docker there).

# --- 1. web UI -----------------------------------------------------------------
FROM node:22-bookworm-slim AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json* ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

# --- 2. python server ----------------------------------------------------------
FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 LANG=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv

WORKDIR /app
COPY pyproject.toml README.md ./
COPY computeruse/ computeruse/
RUN uv pip install --system --no-cache .
COPY --from=web /src/web/dist web/dist

RUN useradd -m -u 1000 app && mkdir -p /data && chown -R app:app /data /app
USER app
ENV COMPUTERUSE_HOST=0.0.0.0 COMPUTERUSE_PORT=8787 COMPUTERUSE_DATA_DIR=/data COMPUTERUSE_WEB_DIST=/app/web/dist
EXPOSE 8787
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s CMD curl -fs http://127.0.0.1:8787/api/health || exit 1
CMD ["computeruse", "serve"]
